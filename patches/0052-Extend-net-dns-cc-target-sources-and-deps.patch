From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Mon, 13 Mar 2023 08:41:43 +0000
Subject: [PATCH] Extend //net/dns cc target sources and deps

---
 net/dns/BUILD.gn                              |  5 ++++
 .../chromium_src/net/dns/dns_ext_cc_deps.gni  | 26 +++++++++++++++++++
 .../net/dns/dns_ext_cc_sources.gni            | 26 +++++++++++++++++++
 3 files changed, 57 insertions(+)
 create mode 100644 vanadium/chromium_src/net/dns/dns_ext_cc_deps.gni
 create mode 100644 vanadium/chromium_src/net/dns/dns_ext_cc_sources.gni

diff --git a/net/dns/BUILD.gn b/net/dns/BUILD.gn
index d1a544567c4bd..c6a2964bc5a5f 100644
--- a/net/dns/BUILD.gn
+++ b/net/dns/BUILD.gn
@@ -220,6 +220,11 @@ source_set("dns") {
     ":host_resolver_manager",
     ":mdns_client",
   ]
+
+  import("//vanadium/chromium_src/net/dns/dns_ext_cc_sources.gni")
+  sources += dns_ext_cc_sources
+  import("//vanadium/chromium_src/net/dns/dns_ext_cc_deps.gni")
+  deps += dns_ext_cc_deps
 }
 
 # The standard API of net/dns.
diff --git a/vanadium/chromium_src/net/dns/dns_ext_cc_deps.gni b/vanadium/chromium_src/net/dns/dns_ext_cc_deps.gni
new file mode 100644
index 0000000000000..fb00b82579e98
--- /dev/null
+++ b/vanadium/chromium_src/net/dns/dns_ext_cc_deps.gni
@@ -0,0 +1,26 @@
