+TEST_F(NtpAndroidCustomBackgroundServiceTest,
+       ProfileServiceDoesNotReplayStoredThemeWithSyncFlagEnabled) {
+  base::test::ScopedFeatureList feature_list(
+      syncer::kNewTabPageCustomizationThemeSync);
+  auto profile = MakeTestingProfile(
+      &locale_storage_,
+      base::MakeRefCounted<network::WeakWrapperSharedURLLoaderFactory>(
+          &test_url_loader_factory_));
+  PrefService* prefs = profile->GetPrefs();
+  base::DictValue preset;
+  preset.Set(kNtpAndroidThemeColorIdKey, kTestColorId);
+  prefs->SetDict(prefs::kNtpAndroidChromeColorDict, preset.Clone());
+
+  auto* profile_service =
+      NtpAndroidCustomBackgroundServiceFactory::GetForProfile(profile.get());
+  ASSERT_TRUE(profile_service);
+  EXPECT_FALSE(profile_service->GetSyncControllerDelegate());
+  EXPECT_TRUE(profile_service->IsThemeSyncReady());
+  InstallStrictMockSyncedBridge(profile_service);
+
+  profile_service->GetStoredContinuousThemeAndNotify();
+  EXPECT_EQ(prefs->GetDict(prefs::kNtpAndroidChromeColorDict), preset);
+  EXPECT_FALSE(prefs->GetUserPrefValue(prefs::kNtpAndroidCustomBackgroundDict));
+  EXPECT_FALSE(prefs->GetBoolean(prefs::kNtpAndroidCustomBackgroundLocalToDevice));
+
+  prefs->ClearPref(prefs::kNtpAndroidChromeColorDict);
+  profile_service->GetStoredContinuousThemeAndNotify();
+  task_environment_.RunUntilIdle();
+
+  EXPECT_FALSE(prefs->GetUserPrefValue(prefs::kNtpAndroidChromeColorDict));
+  EXPECT_FALSE(prefs->GetUserPrefValue(prefs::kNtpAndroidCustomBackgroundDict));
+  EXPECT_FALSE(prefs->GetBoolean(prefs::kNtpAndroidCustomBackgroundLocalToDevice));
+}
