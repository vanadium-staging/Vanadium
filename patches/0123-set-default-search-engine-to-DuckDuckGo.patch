From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zoraver Kang <zkang@wpi.edu>
Date: Sat, 17 Aug 2019 15:53:50 -0400
Subject: [PATCH] set default search engine to DuckDuckGo

---
 components/search_engines/template_url_prepopulate_data.cc | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/components/search_engines/template_url_prepopulate_data.cc b/components/search_engines/template_url_prepopulate_data.cc
index 24e8f47c00242..1ba43a0ab7675 100644
--- a/components/search_engines/template_url_prepopulate_data.cc
+++ b/components/search_engines/template_url_prepopulate_data.cc
@@ -295,7 +295,8 @@ std::unique_ptr<TemplateURLData> GetPrepopulatedFallbackSearch(
     const std::vector<raw_ptr<const PrepopulatedEngine>>&
         regional_prepopulated_engines) {
   return PrepopulatedEngineToTemplateURLData(
-      FindPrepopulatedEngineInternal(regional_prepopulated_engines, google.id,
+      FindPrepopulatedEngineInternal(regional_prepopulated_engines,
+                                     duckduckgo.id,
                                      /*use_first_as_fallback=*/true));
 }
 
