From: Zoraver Kang <zkang@wpi.edu>
Date: Fri, 16 Aug 2019 02:03:45 -0400
Subject: [PATCH] redirect settings help icon

---
 .../browser/feedback/HelpAndFeedbackLauncherDelegate.java | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/chrome/browser/feedback/android/java/src/org/chromium/chrome/browser/feedback/HelpAndFeedbackLauncherDelegate.java b/chrome/browser/feedback/android/java/src/org/chromium/chrome/browser/feedback/HelpAndFeedbackLauncherDelegate.java
index c8bde1b98abb4..98598579faad8 100644
--- a/chrome/browser/feedback/android/java/src/org/chromium/chrome/browser/feedback/HelpAndFeedbackLauncherDelegate.java
+++ b/chrome/browser/feedback/android/java/src/org/chromium/chrome/browser/feedback/HelpAndFeedbackLauncherDelegate.java
@@ -24,8 +24,8 @@ import java.util.List;
 @NullMarked
 public interface HelpAndFeedbackLauncherDelegate {
     String TAG = "HelpAndFeedback";
-    String FALLBACK_SUPPORT_URL = "https://support.google.com/chrome/topic/6069782";
-    String P_LINK_URL_PREFIX = "https://support.google.com/chrome/?p=";
+    String FALLBACK_SUPPORT_URL = "https://grapheneos.org/usage#web-browsing";
+    // String P_LINK_URL_PREFIX = "https://support.google.com/chrome/?p=";
 
     /**
      * Starts an activity showing a help page for the specified context ID.
@@ -54,7 +54,7 @@ public interface HelpAndFeedbackLauncherDelegate {
      * @return The generated help URL.
      */
     static String getPLinkHelpUrl(String helpContext) {
-        return P_LINK_URL_PREFIX + helpContext;
+        return "";
     }
 
     /**
@@ -86,7 +86,7 @@ public interface HelpAndFeedbackLauncherDelegate {
             if (!trimmed.isEmpty()) homepageHelpContexts.add(trimmed);
         }
         String pLinkUrl =
-                homepageHelpContexts.contains(helpContext) ? null : P_LINK_URL_PREFIX + helpContext;
+                homepageHelpContexts.contains(helpContext) ? null : "";
         Log.d(TAG, "Help context: %s, p-link URL: %s", helpContext, pLinkUrl);
         return pLinkUrl;
     }
