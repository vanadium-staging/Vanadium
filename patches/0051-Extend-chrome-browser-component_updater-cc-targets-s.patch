diff --git a/chrome/browser/component_updater/BUILD.gn b/chrome/browser/component_updater/BUILD.gn
index 443627d1d4f44..35ffd1a38e821 100644
--- a/chrome/browser/component_updater/BUILD.gn
+++ b/chrome/browser/component_updater/BUILD.gn
@@ -104,6 +104,11 @@ source_set("component_updater") {
   if (safe_browsing_mode != 0) {
     public += [ "file_type_policies_component_installer.h" ]
   }
+
+  import("//vanadium/chromium_src/chrome/browser/component_updater/component_updater_ext_cc_public.gni")
+  public += component_updater_ext_cc_public
+  import("//vanadium/chromium_src/chrome/browser/component_updater/component_updater_ext_cc_public_deps.gni")
+  public_deps += component_updater_ext_cc_public_deps
 }
 
 # Implementation target. Only .cc/.mm files.
@@ -284,4 +289,9 @@ source_set("impl") {
   if (is_chrome_for_testing) {
     deps += [ "//chrome/browser/chrome_for_testing:browser" ]
   }
+
+  import("//vanadium/chromium_src/chrome/browser/component_updater/component_updater_impl_ext_cc_sources.gni")
+  sources += component_updater_impl_ext_cc_sources
+  import("//vanadium/chromium_src/chrome/browser/component_updater/component_updater_impl_ext_cc_deps.gni")
+  deps += component_updater_impl_ext_cc_deps
 }
