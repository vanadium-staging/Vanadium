From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Thu, 19 Nov 2026 12:00:00 +0000
Subject: [PATCH] Extend //chrome/android chrome_test_java java group deps

---
 chrome/android/BUILD.gn                       |  3 +++
 .../android/chrome_test_java_ext_deps.gni     | 26 +++++++++++++++++++
 2 files changed, 29 insertions(+)
 create mode 100644 vanadium/chromium_src/chrome/android/chrome_test_java_ext_deps.gni

diff --git a/chrome/android/BUILD.gn b/chrome/android/BUILD.gn
index 598db08bf3987..679c33232a5a7 100644
--- a/chrome/android/BUILD.gn
+++ b/chrome/android/BUILD.gn
@@ -1689,6 +1689,9 @@ if (_is_default_toolchain) {
     if (enable_extensions_core) {
       deps += [ "//chrome/browser/ui/android/toolbar:javatests" ]
     }
+
+    import ("//vanadium/chromium_src/chrome/android/chrome_test_java_ext_deps.gni")
+    deps += chrome_test_java_ext_deps
   }
 
   if (enable_vr || enable_arcore) {
diff --git a/vanadium/chromium_src/chrome/android/chrome_test_java_ext_deps.gni b/vanadium/chromium_src/chrome/android/chrome_test_java_ext_deps.gni
new file mode 100644
index 0000000000000..5fa64ff01880e
--- /dev/null
+++ b/vanadium/chromium_src/chrome/android/chrome_test_java_ext_deps.gni
@@ -0,0 +1,26 @@
+# Copyright 2026 GrapheneOS
+# Use of this source code is governed by a GPL-2.0-only style license that can be
+# found in the LICENSE file.
+
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+chrome_test_java_ext_full_path_deps = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+chrome_test_java_ext_rel_path_deps = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+chrome_test_java_ext_deps = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+chrome_test_java_ext_deps += chrome_test_java_ext_full_path_deps
+foreach(rel_path, chrome_test_java_ext_rel_path_deps) {
+  chrome_test_java_ext_deps += [ rebase_path(rel_path) ]
+}
