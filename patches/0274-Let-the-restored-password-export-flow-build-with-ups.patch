+package org.chromium.chrome.browser.password_manager.settings;
+
+import org.chromium.build.annotations.NullMarked;
+
+/** This is an interface for delaying running of callbacks. */
+@NullMarked
+interface CallbackDelayer {
+    /**
+     * Run a callback after a delay specific to a particular implementation. The callback is always
+     * run asynchronously.
+     * @param callback The callback to be run.
+     */
+    void delay(Runnable callback);
+}
diff --git a/vanadium/chromium_src/chrome/browser/password_manager/android/java/src/org/chromium/chrome/browser/password_manager/settings/DialogManager.java b/vanadium/chromium_src/chrome/browser/password_manager/android/java/src/org/chromium/chrome/browser/password_manager/settings/DialogManager.java
