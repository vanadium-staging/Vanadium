+TEST_F(NtpAndroidCustomBackgroundServiceTest,
+       UnavailableMetadataKeepsLocalTheme) {
+  auto profile = TestingProfile::Builder().Build();
+  EXPECT_EQ(nullptr,
+            NtpAndroidBackgroundServiceFactory::GetForProfile(profile.get()));
+
+  auto store = syncer::DataTypeStoreTestUtil::CreateInMemoryStoreForTest();
+  NtpAndroidCustomBackgroundService service(
+      profile.get(),
+      syncer::DataTypeStoreTestUtil::FactoryForForwardingStore(store.get()));
+  service.SelectLocalBackgroundImage(base::FilePath());
+
+  service.SetCustomBackgroundInfo(GURL(kTestValidUrl), GURL(), "", "", GURL(),
+                                  kTestCollectionId);
+  service.UpdateThemeCollectionPrefsWithColor(
+      GURL(kTestValidUrl), kTestCollectionId, "", "", GURL(), SK_ColorBLUE,
+      /*is_daily_refresh=*/false);
+
+  EXPECT_TRUE(profile->GetPrefs()->GetBoolean(
+      prefs::kNtpAndroidCustomBackgroundLocalToDevice));
+  EXPECT_FALSE(profile->GetPrefs()->GetUserPrefValue(
+      prefs::kNtpAndroidCustomBackgroundDict));
+}
+
+TEST_F(NtpAndroidCustomBackgroundServiceTest,
+       LegacyWallpaperWithoutMetadataStaysInert) {
+  auto profile = TestingProfile::Builder().Build();
+  const auto specifics = CreateTestThemeSpecifics(
+      kTestValidUrl, kTestCollectionId, /*daily_refresh_enabled=*/true);
+  auto background =
+      themes::GetBackgroundDictFromProto(specifics.ntp_background());
+  background.Set(kNtpCustomBackgroundResumeToken, "resume");
+  profile->GetPrefs()->SetDict(prefs::kNtpAndroidCustomBackgroundDict,
+                               std::move(background));
+  auto service = CreateServiceWithThemeSyncEnabled(profile.get());
+  InstallStrictMockSyncedBridge(service.get());
+
+  service->GetStoredContinuousThemeAndNotify();
+  service->RefreshBackgroundIfNeeded();
+
+  EXPECT_FALSE(service->GetCustomBackground().has_value());
+  EXPECT_TRUE(profile->GetPrefs()->GetUserPrefValue(
+      prefs::kNtpAndroidCustomBackgroundDict));
+}
