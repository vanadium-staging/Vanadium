Subject: [PATCH] Enable reduce accept language header by default

This now reduces accept language count to 2.
---
 components/language/core/browser/language_prefs.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/components/language/core/browser/language_prefs.h b/components/language/core/browser/language_prefs.h
index 112ab04e591ee..c6400e443cfca 100644
--- a/components/language/core/browser/language_prefs.h
+++ b/components/language/core/browser/language_prefs.h
@@ -34,7 +34,7 @@ inline constexpr char kFallbackInputMethodLocale[] = "en-US";
 // Maximum number of languages to include in the Accept-Language HTTP header and
 // JavaScript navigator.languages getter to enhance privacy. See details in
 // https://datatracker.ietf.org/doc/html/rfc7231#section-9.7.
-inline constexpr size_t kMaxAcceptLanguageCount = 10;
+inline constexpr size_t kMaxAcceptLanguageCount = 2;
 
 class LanguagePrefs {
  public:
