@@ -34,6 +34,7 @@ public final class SiteSettingsHooksRegistry {
             @ContentSettingsType.EnumType int contentType) {
         return switch (contentType) {
             case ContentSettingsType.JAVASCRIPT_JIT -> new JavascriptJitSettingsHooks.SingleWebsiteSettingsHooksImpl();
+            case ContentSettingsType.SENSORS -> new SensorsSettingsHooks.SingleWebsiteSettingsHooksImpl();
             default -> SingleWebsiteSettingsHooks.getDefaultInstance();
         };
     }
@@ -74,6 +75,7 @@ public final class SiteSettingsHooksRegistry {
             @ContentSettingsType.EnumType int contentType) {
         return switch (contentType) {
             case ContentSettingsType.JAVASCRIPT_JIT -> new JavascriptJitSettingsHooks.WebsitePermissionsFetcherHooksImpl();
+            case ContentSettingsType.SENSORS -> new SensorsSettingsHooks.WebsitePermissionsFetcherHooksImpl();
             default -> WebsitePermissionsFetcherHooks.getDefaultInstance();
         };
     }
